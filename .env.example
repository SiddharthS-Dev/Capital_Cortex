# Copy to .env (never commit .env). No credential has a committed default: compose refuses to start until every
# empty secret below is set. Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Host ports (a dedicated block so the stack coexists with other local projects)
WEB_PORT=3300
API_PORT=8300
KEYCLOAK_PORT=8380
OPA_PORT=8381
VAULT_PORT=8382
PG_PORT=55432
REDIS_PORT=56379
MINIO_PORT=9300
MINIO_CONSOLE_PORT=9301
GRAFANA_PORT=3301
PROMETHEUS_PORT=9390
# Ops tooling (Phase 3). make load: second API on the load database (compose profile `load`).
LOAD_API_PORT=8384
# make restore-drill: the scratch Postgres the latest backup is restored into (127.0.0.1 only, removed after).
DRILL_PG_PORT=8386

# Load test knobs (scripts/load_test.py; tests/load/README.md). LOAD_SCALE=1 is the 1M-node seed.
LOAD_SCALE=1
LOAD_DURATION=5m
LOAD_RATE_MULT=1
# abort k6 + api-load when the Docker VM's MemAvailable drops below this (shared machine protection)
LOAD_MIN_AVAILABLE_MB=900

# Dev credentials (empty on purpose; set your own). Prod secrets come from Vault/KMS.
# Required by infra/docker-compose.yml while it still holds the PostgreSQL rollback stack. Unused by MySQL itself.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=cortex
MINIO_ROOT_PASSWORD=
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
VAULT_DEV_ROOT_TOKEN=
# Keycloak client secrets: the dev realm import reads them through ${VAR} placeholders (generate_realm.py).
WORKER_CLIENT_SECRET=
API_CLIENT_SECRET=
INGESTION_CLIENT_SECRET=
# Password of every dev-realm user (dev-*, smoke-auditor); also used by smoke, E2E and the demo scripts.
# Must satisfy the realm password policy: 12+ characters, an upper-case letter, a digit and a special
# character; no double quote or backslash.
SMOKE_USER_PASSWORD=
# smoke-auditor's TOTP seed (hex or text): give it to generate_realm.py when building a realm for smoke/E2E.
SMOKE_TOTP_SECRET=

# MySQL 8.4 stack (infra/docker-compose.mysql.yml). NO defaults: compose refuses to start until these are set.
# MYSQL_PASSWORD is embedded in DATABASE_URL, so use URL-safe characters only (letters, digits, - _ . ~).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Optional DML-only runtime account for api and worker (infra/mysql/runtime_account.sql). Empty: they use MYSQL_USER.
MYSQL_APP_USER=
MYSQL_APP_PASSWORD=
MYSQL_USER=cortex
MYSQL_DATABASE=cortex
# Host binding of the MySQL port; local default 127.0.0.1. Production: add infra/docker-compose.mysql-private.yml.
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=53306

# MySQL backups (scripts/backup_mysql.py, CORTEX_MYSQL_CUTOVER_RUNBOOK.md). Destination: a local/mounted directory
# or s3://bucket/prefix on an approved, off-host S3-compatible store. Encryption is on unless --allow-unencrypted.
# Key: 32 random bytes, base64. Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Keep the key in the secret store (MYSQL_BACKUP_ENCRYPTION_KEY_FILE points at a mounted secret); a lost key = lost backups.
MYSQL_BACKUP_CONTAINER=capital-cortex-mysql
MYSQL_BACKUP_DATABASES=cortex,keycloak
MYSQL_BACKUP_DEST=
MYSQL_BACKUP_ENCRYPTION_KEY=
MYSQL_BACKUP_ENCRYPTION_KEY_FILE=
MYSQL_BACKUP_KEEP=14
MYSQL_BACKUP_S3_ENDPOINT=
MYSQL_BACKUP_S3_ACCESS_KEY=
MYSQL_BACKUP_S3_SECRET_KEY=
MYSQL_BACKUP_S3_SECURE=true

# Migration ETL (scripts/migrate_pg_to_mysql.py). Passwords never go on the command line.
# Remote hosts require verified TLS: --mysql-ssl-mode VERIFY_IDENTITY --mysql-ssl-ca <ca.pem>, --pg-sslmode verify-full.
MIGRATION_PG_PASSWORD=
MIGRATION_MYSQL_PASSWORD=

# LLM. Without a key the classifier stays rules-only and the 13 agents run in labelled deterministic mode
# (claims taken from their tools, still citation-checked). With a key they deliberate with the small/mid/large tiers.
ANTHROPIC_API_KEY=
LLM_DAILY_BUDGET_USD=25

# Governed actuation (I3): HS256 key that signs approval tokens (≥ 32 chars). Approvals fail closed without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_KEY=
# Outbound e-mail (dev default: the Mailpit container). Internal alert e-mail only goes to these domains.
SMTP_URL=smtp://mailpit:1025
INTERNAL_EMAIL_DOMAINS=["inspironics.net"]
MAILPIT_PORT=8383

# Business settings (§12)
MIN_CASH_BUFFER=0
RUNWAY_ALERT_MONTHS=9
DEMO_MODE=false

# Platform administrator, applied to Keycloak by scripts/bootstrap_admin.py on `make up`.
# Set these in .env only (never commit real credentials). The admin role requires TOTP enrolment at first login.
CORTEX_ADMIN_EMAIL=
CORTEX_ADMIN_PASSWORD=

# MFA for Admin/Approver/Auditor/Executive (R5). false = local development only (D-033).
CORTEX_MFA_REQUIRED=true

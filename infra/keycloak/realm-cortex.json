  ],
  "authenticatorConfig": [
    {
      "alias": "amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "amr-otp-optional",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "cond-mfa-required",
      "config": {
        "condUserRole": "mfa-required",
        "negate": "false"
      }
    },
    {
      "alias": "cond-not-mfa-required",
      "config": {
        "condUserRole": "mfa-required",
        "negate": "true"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-cortex",
      "description": "Browser login; OTP required for Admin/Approver/Auditor/Executive (R5)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie"
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "browser-cortex forms"
        }
      ]
    },
    {
      "alias": "browser-cortex forms",
      "description": "Password, then OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "amr-pwd"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "browser-cortex mfa-required"
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "flowAlias": "browser-cortex mfa-optional"
        }
      ]
    },
    {
      "alias": "browser-cortex mfa-required",
      "description": "Privileged roles must use OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "cond-mfa-required"
        },
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr-otp"
        }
      ]
    },
    {
      "alias": "browser-cortex mfa-optional",
      "description": "Analysts who enrolled OTP use it",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "cond-not-mfa-required"
        },
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr-otp-optional"
        }
      ]
    }
  ]
}

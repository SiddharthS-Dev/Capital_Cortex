{
  "realm": "cortex",
  "displayName": "Inspironics Capital Cortex",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername and upperCase(1) and digits(1) and specialChars(1)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "browserFlow": "browser-cortex",
  "roles": {
    "realm": [
      {
        "name": "mfa-required",
        "description": "Marker: login must include OTP (R5)"
      },
      {
        "name": "admin",
        "description": "Platform administrator",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "analyst",
        "description": "Capital analyst (MFA optional)"
      },
      {
        "name": "approver",
        "description": "Human-in-the-loop approver",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "auditor",
        "description": "Read-only oversight",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "executive",
        "description": "Board / executive",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "service",
        "description": "Non-human workers"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cortex-web",
      "name": "Capital Cortex UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3300/*",
        "http://localhost:5373/*"
      ],
      "webOrigins": [
        "http://localhost:3300",
        "http://localhost:5373"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3300/*##http://localhost:5373/*"
      },
      "protocolMappers": [
        {
          "name": "audience-cortex-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cortex-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "cortex-grants",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "cortex_grants",
            "claim.name": "cortex_grants",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cortex-api",
      "name": "Capital Cortex API (audience only)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "dev-api-secret-change-me"
    },
    {
      "clientId": "cortex-worker",
      "name": "Capital Cortex workers",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-worker-secret-change-me",
      "protocolMappers": [
        {
          "name": "audience-cortex-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cortex-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cortex-ingestion",
      "name": "Capital Cortex ingestion",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-ingestion-secret-change-me",
      "protocolMappers": [
        {
          "name": "audience-cortex-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cortex-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
